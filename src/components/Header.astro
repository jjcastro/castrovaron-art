---
import HeaderLink from "./HeaderLink.astro";
import { SITE_TITLE } from "../consts";
---

<header class="fixed m-0 px-4 tgbe-font">
  <nav class="flex flex-col">
    <h2 class="m-0 text-base flex py-8 px-4 text-[1.25rem]!">
      <a href="/" class="no-underline text-[1.25rem]">{SITE_TITLE}</a>
    </h2>

    <div class="flex justify-between absolute top-30">
      <div class="flex flex-col px-4 text-[1rem]">
        <HeaderLink href="/">home</HeaderLink>
        <HeaderLink href="/blog">blog</HeaderLink>
        <HeaderLink href="/about">about</HeaderLink>
      </div>
    </div>
  </nav>
</header>
