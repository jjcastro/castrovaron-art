---
import type { HTMLAttributes } from "astro/types";
import { localeFromPath } from "../i18n";

type Props = HTMLAttributes<"a"> & { href: string };

const { href, class: className, ...props } = Astro.props;
// Active when the current page is in the same section (/work/... or /about/).
const section = (path: string) => localeFromPath(path).rest.split("/")[1];
const isActive = section(href) !== "" && section(href) === section(Astro.url.pathname);
---

<a href={href} class:list={[className, { active: isActive }]} {...props}>
  <slot />
</a>
<style>
  a {
    color: black;
    display: inline-block;
    text-decoration: none;
  }
  a.active {
    color: black;
    font-weight: bolder;
    text-decoration: underline;
  }
</style>
