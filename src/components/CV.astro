---
// The CV list on the About pages: a heading per section, then rows of
// [years, text, optional grey note underneath].
export type CVRow = [string, string, string?];
export interface CVSection {
  title: string;
  rows: CVRow[];
}

interface Props {
  born: string[];
  sections: CVSection[];
}

const { born, sections } = Astro.props;
---

<ul class="list-none p-0 mb-8">
  {born.map((line) => <li>{line}</li>)}
</ul>

{
  sections.map((section) => (
    <div class="mb-8">
      <h4 class="tgbe-font text-[1rem]!">{section.title}:</h4>
      <ul class="list-none p-0 m-0">
        {section.rows.map(([years, text, note]) => (
          <li class="flex">
            <span class="w-[5.5em] shrink-0">{years}</span>
            <span>
              {text}
              {note && (
                <>
                  <br />
                  <span class="text-gray-400">{note}</span>
                </>
              )}
            </span>
          </li>
        ))}
      </ul>
    </div>
  ))
}
