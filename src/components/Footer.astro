---
import LangPicker from "./LangPicker.astro";

const today = new Date();
---

<footer
  class="text-[1rem] md:fixed bottom-0 left-0 py-8 px-4 md:px-8 w-full md:w-[21rem] flex md:flex-col justify-between gap-8 md:gap-1"
>
  <!-- On mobile the languages live in the sticky top bar instead -->
  <LangPicker class="hidden md:flex" />
  <div class="plantin-font">
    &copy; {today.getFullYear()}
  </div>
</footer>
