---
import Layout from "../../layouts/Page.astro";
import CV, { type CVSection } from "../../components/CV.astro";
import { ui } from "../../i18n";

const cv: CVSection[] = [
  {
    title: "교육 & 레지던시",
    rows: [
      ["2025-2026", "베이스폼 레지던시, 서울"],
      ["2025-2026", "베이스폼 주얼리 아카데미, 서울"],
      ["2024-2026", "K2 아카데미 오브 컨템포러리 주얼리, 런던", "2년 과정"],
      ["2023-2026", "서머셋 하우스 Makerversity Under-30 레지던시, 런던"],
      ["2022-2023", "센트럴 세인트 마틴 등에서 공예 과정 수강"],
      ["2014-2018", "로스안데스 대학교, 보고타, 콜롬비아", "컴퓨터 공학*, 그래픽 디자인 부전공"],
    ],
  },
  {
    title: "공공 소장",
    rows: [
      ["2025", "대영박물관"],
      ["2025", "골드스미스 컴퍼니"],
      ["2025", "왕립 조폐국 박물관"],
      ["2025", "미국 화폐학회, 뉴욕"],
      ["2025", "영국 예술 메달 협회"],
      ["", "해로우 스쿨 올드 스피치 룸 갤러리"],
    ],
  },
  {
    title: "수상 내역",
    rows: [
      ["2026", "골드스미스 크래프트 & 디자인 어워드 - 브론즈 어워드 (스몰워커 부문)"],
      ["2024", "골드스미스 크래프트 & 디자인 어워드 - 골드 어워드 (디자인 부문)"],
    ],
  },
  {
    title: "단체 전시",
    rows: [
      ["2025-2026", "콕핏 오픈 스튜디오, K2 아카데미 참여, 런던"],
      ["2024", "셰필드, 골드스미스 노스 7월 12일 - 14일 @ 셰필드 커틀러스 홀"],
      ["2024", "런던 골드스미스 센터 여름 전시 7월 12일 - 14일"],
      ["2024", "버밍엄 감정소 12일 - 14일"],
      ["2024", "런던 골드스미스 홀 3월"],
    ],
  },
  {
    title: "강연",
    rows: [
      ["2026", "영국 예술 메달 협회 컨퍼런스, 판햄"],
      ["2025", "페차쿠차 @ Makerversity, 서머셋 하우스, 런던"],
      ["2024", "도시는 박물관이 아니다: 런던은 어떻게 적응하고 변화하는가", "오픈 하우스 페스티벌 2024 - 2시간 도보 투어"],
    ],
  },
  {
    title: "언어",
    rows: [["", "스페인어 (모국어), 영어, 프랑스어, 한국어"]],
  },
];
---

<Layout title={ui.kr.aboutTitle}>
  <p>
    안녕하세요 👋🏼 저는 후안입니다. 런던(또는 2025-2026년 한국 서울)을
    기반으로 활동하는 아티스트, 디자이너, 그리고 엔지니어*입니다. 저는
    무언가를 만드는 것을 좋아합니다. 요즘은 건축 환경에서 영감을 받거나
    우리를 둘러싼 재료에 대해 생각하며 주얼리와 작은 오브제를 만듭니다.
  </p>

  <p>
    스튜디오 작업 외에도 저는 Minilith (<a
      href="http://minilith.co.uk"
      class="underline!">minilith.co.uk</a
    >)라는 주얼리 브랜드를 운영하며, 모더니즘 건축에서 영감을 받은 실버
    주얼리를 만듭니다. Minilith는 디자이너, 장인, 발명가들의 커뮤니티인
    Makerversity의 일부입니다.
  </p>

  <p>
    저는 런던 중심부의 역사적인 예술 센터인 <a
      href="https://www.somersethouse.org.uk/"
      class="underline!">서머셋 하우스</a
    >, 또는 서울 마포구의 베이스폼을 기반으로 활동합니다.<br />연락은 <span class="whitespace-nowrap">
      juan<span
        class="inline-block relative before:content-['@'] before:absolute"
        ><span class="inline-block overflow-clip opacity-0 text-[0.65em]"
          >[at]</span
        >castrovaron.com</span
      ></span
    >으로 주세요.
  </p>

  <hr class="my-8" />

  <CV born={["1997년생", "콜롬비아"]} sections={cv} />

  <hr class="my-10" />
  <p>
    * 이전 커리어에서 저는 컴퓨터 공학을 공부했고 2017년부터 2023년까지
    Google에서 소프트웨어 엔지니어로 일했습니다. 2023년, 컴퓨터를 보는 시간을
    줄이고 무언가를 만드는 데 더 많은 시간을 쓰기로 했습니다. 예전 웹사이트
    아카이브는 <a href="https://dev.castrovaron.com" class="underline!">여기</a>에서
    볼 수 있습니다 (주의: 꽤 오래되었습니다).
  </p>
</Layout>
