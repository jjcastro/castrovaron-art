---
import BaseHead from "../components/BaseHead.astro";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import { SITE_TITLE, SITE_DESCRIPTION } from "../consts";
import { Image } from "astro:assets";
import image1 from "../bundled-images/IMG_1506.JPG";
import image2 from "../bundled-images/IMG_1507.JPG";
import image3 from "../bundled-images/IMG_1508.JPG";
import image4 from "../bundled-images/IMG_1509.JPG";
import image5 from "../bundled-images/IMG_1510.JPG";
import image6 from "../bundled-images/IMG_1511.JPG";
import image7 from "../bundled-images/IMG_1512.JPG";
import image8 from "../bundled-images/IMG_1513.JPG";
import image9 from "../bundled-images/IMG_1514.JPG";
import image10 from "../bundled-images/IMG_1515.JPG";
import image11 from "../bundled-images/IMG_1516.JPG";
import image12 from "../bundled-images/IMG_1517.JPG";
import image13 from "../bundled-images/IMG_1518.JPG";
import image14 from "../bundled-images/IMG_1519.JPG";
import image15 from "../bundled-images/IMG_1520.JPG";
---

<!doctype html>
<html lang="en">
  <head>
    <BaseHead title={SITE_TITLE} description={SITE_DESCRIPTION} />
  </head>
  <body class="plantin-font">
    <Header />
    <main>
      <!-- <h1>🧑‍🚀 Hello, Astronaut!</h1> -->
      <Image src={image1} alt="A description of my image." />
      <span
        >Walnut sapwood and bark, sterling silver, leather cord, wax. (2025)</span
      >
      <Image src={image6} alt="A description of my image." />
      <span>Iron ebonized oak, leather cord, sterling silver, wax. (2025)</span>
      <Image src={image8} alt="A description of my image." />
      <span>Walnut wood, leather cord, sterling & fine silver, wax. (2025)</span
      >
      <Image src={image15} alt="A description of my image." />
      <span
        >Walnut bark, epoxy resin, leather cord, sterling silver, wax. (2025)</span
      >
    </main>
    <Footer />
  </body>
</html>
