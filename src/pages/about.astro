---
import Layout from "../layouts/Page.astro";
import CV, { type CVSection } from "../components/CV.astro";
import { ui } from "../i18n";

const cv: CVSection[] = [
  {
    title: "Education & Residencies",
    rows: [
      ["2025-2026", "Resident @ Baseform (베이스폼), Seoul"],
      ["2025-2026", "Baseform Jewellery Academy (베이스폼), Seoul"],
      ["2024-2026", "K2 Academy of Contemporary Jewellery, London", "2 year course"],
      ["2023-2026", "Under-30 Resident @ Somerset House's Makerversity, London"],
      ["2022-2023", "Craft courses at Central Saint Martins & Others"],
      ["2014-2018", "Universidad de los Andes, Bogotá, Colombia", "Computer Science* minor in Graphic Design"],
    ],
  },
  {
    title: "Work in Public Collections",
    rows: [
      ["2025", "British Museum"],
      ["2025", "The Goldsmiths' Company"],
      ["2025", "The Royal Mint Museum"],
      ["2025", "American Numismatic Society, New York"],
      ["2025", "British Art Medal Society"],
      ["", "Old Speech Room Gallery, Harrow School"],
    ],
  },
  {
    title: "Awards",
    rows: [
      ["2026", "Goldsmiths' Craft & Design Awards - Bronze Award (Smallworkers)"],
      ["2024", "Goldsmiths' Craft & Design Awards - Gold Award (Design)"],
    ],
  },
  {
    title: "Group Exhibitions",
    rows: [
      ["2025-2026", "Cockpit Open Studios, as part of K2 Academy, London"],
      ["2024", "Sheffield, Goldsmiths North 12 - 14 July @ Sheffield's Cutlers' Hall"],
      ["2024", "London Goldsmiths' Centre, Summer Exhibition 12 - 14 July"],
      ["2024", "Birmingham Assay Office 12 - 14"],
      ["2024", "London Goldsmiths' Hall March"],
    ],
  },
  {
    title: "Public speaking",
    rows: [
      ["2026", "British Art Medal Society Conference, Farnham"],
      ["2025", "PechaKucha @ Makerversity, Somerset House, London"],
      ["2024", "A city is not a museum: how London adapts and changes", "Open House Festival 2024 - 2 hour walking tour"],
    ],
  },
  {
    title: "Languages",
    rows: [["", "Spanish (native), English, French, Korean"]],
  },
];
---

<Layout title={ui.en.aboutTitle}>
  <p>
    Hiya 👋🏼 I'm Juan. I'm an artist, designer and engineer* based out of London
    (or Seoul, Korea 2025-2026). I like making things. These
    days I make jewellery and small objects, inspired by the built environment
    or reflecting on the materials that surround us.
  </p>

  <p>
    In addition to my studio work, I run a jewellery brand called Minilith (<a
      href="http://minilith.co.uk"
      class="underline!">minilith.co.uk</a
    >), making silver jewellery inspired by modernist architecture. Minilith is
    part of Makerversity, a community of designers, craftspeople and inventors.
  </p>

  <p>
    I'm based in <a
      href="https://www.somersethouse.org.uk/"
      class="underline!">Somerset House</a
    >, central London's historic arts center, or in Baseform (베이스폼) in
    Seoul's Mapo district.<br />You
    can contact me at <span>
      juan<span
        class="inline-block relative before:content-['@'] before:absolute"
        ><span class="inline-block overflow-clip opacity-0 text-[0.65em]"
          >[at]</span
        >castrovaron.com</span
      ></span
    >
  </p>

  <hr class="my-8" />

  <CV born={["Born 1997", "Colombia"]} sections={cv} />

  <hr class="my-10" />
  <p>
    * In a previous career, I did computer science and worked as a software
    engineer at Google from 2017 to 2023. In 2023, I decided to spend more time
    making and less time looking at a computer. You can find my old archived
    website <a href="https://castrovaron.pages.dev" class="underline!">here</a>
    (beware, it's quite outdated).
  </p>
</Layout>
