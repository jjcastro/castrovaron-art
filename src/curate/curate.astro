---
// Local-only photo picker for the home page. Injected by the `curate`
// integration in astro.config.mjs when running `astro dev`; never built.
import { getImage } from "astro:assets";
import { orderedPhotos } from "../data/home";

const photos = await Promise.all(
  orderedPhotos().map(async (p) => ({
    ...p,
    thumb: (await getImage({ src: p.image, width: 360 })).src,
  })),
);
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width,initial-scale=1" />
    <title>Curate home page</title>
    <style>
      :root { color-scheme: light; }
      body { margin: 0; font: 14px/1.4 system-ui, sans-serif; background: #f4f4f2; color: #111; }
      header { position: sticky; top: 0; z-index: 2; background: #fff; border-bottom: 1px solid #ddd;
        padding: 12px 16px; display: flex; flex-wrap: wrap; gap: 8px 16px; align-items: center; }
      header p { margin: 0; color: #555; flex: 1 1 320px; }
      button, a.btn { font: inherit; padding: 6px 12px; border: 1px solid #111; background: #fff; color: #111;
        cursor: pointer; text-decoration: none; border-radius: 0; }
      button.primary { background: #111; color: #fff; }
      #status { min-width: 8em; color: #2a7a2a; }
      #grid { list-style: none; margin: 0; padding: 16px; display: grid; gap: 12px;
        grid-template-columns: repeat(auto-fill, minmax(150px, 1fr)); }
      #grid li { background: #fff; border: 1px solid #ddd; padding: 6px; cursor: grab; position: relative;
        user-select: none; }
      #grid li.hidden img { opacity: 0.25; filter: grayscale(1); }
      #grid li.hidden .tag::after { content: " · hidden"; color: #b33; }
      #grid li.ghost { opacity: 0.4; }
      #grid img { display: block; width: 100%; height: 150px; object-fit: contain; background: #eee;
        pointer-events: none; }
      .tag { font-size: 12px; margin-top: 4px; color: #444; }
      .num { position: absolute; top: 10px; left: 10px; background: #111; color: #fff; font-size: 11px;
        padding: 1px 5px; }
      .toggle { position: absolute; top: 10px; right: 10px; padding: 1px 6px; font-size: 12px; }
    </style>
  </head>
  <body>
    <header>
      <strong>Home page photos</strong>
      <p>Drag to reorder. Click a photo (or its button) to hide or show it. Save writes
        <code>src/data/home.json</code>; the home page updates straight away.</p>
      <span id="count"></span>
      <button id="showAll">Show all</button>
      <button id="save" class="primary">Save</button>
      <a class="btn" href="/" target="_blank">Open home ↗</a>
      <span id="status"></span>
    </header>

    <ul id="grid">
      {
        photos.map((p) => (
          <li data-id={p.id} class:list={{ hidden: p.hidden }}>
            <span class="num" />
            <img src={p.thumb} alt={p.alt} loading="lazy" />
            <button class="toggle" type="button">{p.hidden ? "show" : "hide"}</button>
            <div class="tag">{p.label}</div>
          </li>
        ))
      }
    </ul>

    <script is:inline src="https://cdn.jsdelivr.net/npm/sortablejs@1.15.2/Sortable.min.js"></script>
    <script is:inline>
      const grid = document.getElementById("grid");
      const status = document.getElementById("status");
      const count = document.getElementById("count");
      let dirty = false;

      function refresh() {
        let n = 0;
        grid.querySelectorAll("li").forEach((li) => {
          const hidden = li.classList.contains("hidden");
          li.querySelector(".num").textContent = hidden ? "–" : ++n;
          li.querySelector(".toggle").textContent = hidden ? "show" : "hide";
        });
        count.textContent = n + " of " + grid.children.length + " shown";
      }
      function changed() { dirty = true; status.textContent = "Unsaved changes"; status.style.color = "#b36b00"; refresh(); }

      new Sortable(grid, { animation: 150, ghostClass: "ghost", onEnd: changed });

      grid.addEventListener("click", (e) => {
        const li = e.target.closest("li");
        if (!li) return;
        li.classList.toggle("hidden");
        changed();
      });

      document.getElementById("showAll").onclick = () => {
        grid.querySelectorAll("li.hidden").forEach((li) => li.classList.remove("hidden"));
        changed();
      };

      document.getElementById("save").onclick = async () => {
        const items = [...grid.querySelectorAll("li")];
        const body = {
          order: items.map((li) => li.dataset.id),
          hidden: items.filter((li) => li.classList.contains("hidden")).map((li) => li.dataset.id),
        };
        status.textContent = "Saving…";
        const res = await fetch("/__curate/save", {
          method: "POST",
          headers: { "content-type": "application/json" },
          body: JSON.stringify(body),
        });
        if (res.ok) { dirty = false; status.textContent = "Saved ✓"; status.style.color = "#2a7a2a"; }
        else { status.textContent = "Save failed: " + (await res.text()); status.style.color = "#b33"; }
      };

      window.addEventListener("beforeunload", (e) => { if (dirty) e.preventDefault(); });
      refresh();
    </script>
  </body>
</html>
